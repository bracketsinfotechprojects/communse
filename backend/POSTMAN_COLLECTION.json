{
	"info": {
		"_postman_id": "chat-system-collection",
		"name": "Chat System API",
		"description": "Complete collection for testing the live chat system",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"yourpassword\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						},
						"description": "Login to get JWT token"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.to.have.status(200)) {",
									"    const response = pm.response.json();",
									"    if (response.token) {",
									"        pm.collectionVariables.set('jwtToken', response.token);",
									"        console.log('Token set:', response.token);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "Chat Messages",
			"item": [
				{
					"name": "Send Message",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"text\": \"Hello everyone! This is a test message 🚀\",\n  \"attachments\": []\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/communities/{{communityId}}/messages",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"communities",
								"{{communityId}}",
								"messages"
							]
						},
						"description": "Send a new message to the community"
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.to.have.status(201)) {",
									"    const response = pm.response.json();",
									"    if (response.data && response.data._id) {",
									"        pm.collectionVariables.set('lastMessageId', response.data._id);",
									"        console.log('Message ID set:', response.data._id);",
									"    }",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Get Messages",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/communities/{{communityId}}/messages?limit=50",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"communities",
								"{{communityId}}",
								"messages"
							],
							"query": [
								{
									"key": "limit",
									"value": "50"
								},
								{
									"key": "before",
									"value": "",
									"disabled": true
								}
							]
						},
						"description": "Get messages for the community with pagination"
					}
				},
				{
					"name": "Mark Message as Read",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/messages/{{messageId}}/read",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"messages",
								"{{messageId}}",
								"read"
							]
						},
						"description": "Mark a specific message as read by current user"
					}
				},
				{
					"name": "Get Unread Count",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/communities/{{communityId}}/unread",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"communities",
								"{{communityId}}",
								"unread"
							]
						},
						"description": "Get unread message count for the community"
					}
				},
				{
					"name": "Edit Message",
					"request": {
						"method": "PATCH",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"text\": \"This message has been edited! ✏️\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/messages/{{messageId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"messages",
								"{{messageId}}"
							]
						},
						"description": "Edit your own message"
					}
				},
				{
					"name": "Delete Message",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/messages/{{messageId}}",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"messages",
								"{{messageId}}"
							]
						},
						"description": "Delete your own message (soft delete)"
					}
				}
			]
		},
		{
			"name": "WebSocket Testing",
			"item": [
				{
					"name": "Connect to WebSocket",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							}
						],
						"url": {
							"raw": "{{wsUrl}}",
							"host": [
								"{{wsUrl}}"
							]
						},
						"description": "WebSocket connection endpoint"
					}
				},
				{
					"name": "Join Community Room",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"event\": \"join_community\",\n  \"data\": {\n    \"communityId\": \"{{communityId}}\"\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{wsUrl}}/join",
							"host": [
								"{{wsUrl}}"
							],
							"path": [
								"join"
							]
						},
						"description": "Join community WebSocket room"
					}
				},
				{
					"name": "Send Real-time Message",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"event\": \"send_message\",\n  \"data\": {\n    \"communityId\": \"{{communityId}}\",\n    \"text\": \"Real-time message via WebSocket! 🚀\",\n    \"attachments\": []\n  }\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{wsUrl}}/send",
							"host": [
								"{{wsUrl}}"
							],
							"path": [
								"send"
							]
						},
						"description": "Send message via WebSocket for real-time updates"
					}
				}
			]
		},
		{
			"name": "Error Testing",
			"item": [
				{
					"name": "Send Message - Validation Error",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"text\": \"{{$repeat('x', 6000)}}\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/communities/{{communityId}}/messages",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"communities",
								"{{communityId}}",
								"messages"
							]
						},
						"description": "Test validation error - message too long"
					}
				},
				{
					"name": "Send Message - Not Member",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"text\": \"This should fail\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/communities/507f1f77bcf86cd799439999/messages",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"communities",
								"507f1f77bcf86cd799439999",
								"messages"
							]
						},
						"description": "Test authorization error - not a member of community"
					}
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Set default values if not already set",
					"if (!pm.collectionVariables.get('baseUrl')) {",
					"    pm.collectionVariables.set('baseUrl', 'http://localhost:5000/api');",
					"}",
					"if (!pm.collectionVariables.get('wsUrl')) {",
					"    pm.collectionVariables.set('wsUrl', 'ws://localhost:5000');",
					"}"
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:5000/api"
		},
		{
			"key": "wsUrl",
			"value": "ws://localhost:5000"
		},
		{
			"key": "jwtToken",
			"value": ""
		},
		{
			"key": "communityId",
			"value": ""
		},
		{
			"key": "messageId",
			"value": ""
		},
		{
			"key": "lastMessageId",
			"value": ""
		}
	]
}