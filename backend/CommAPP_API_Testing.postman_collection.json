{
	"info": {
		"_postman_id": "commapp-firebase-api",
		"name": "CommAPP Firebase API Testing",
		"description": "Complete testing collection for CommAPP API with Firebase integration",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"firstName\": \"Test\",\n  \"lastName\": \"User\",\n  \"agreedToTOS\": true\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"register"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (responseCode.code === 201) {",
									"    pm.environment.set('registrationSuccess', 'true');",
									"    console.log('User registered successfully');",
									"} else {",
									"    pm.environment.set('registrationSuccess', 'false');",
									"    console.log('Registration failed:', responseBody);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"login"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (responseCode.code === 200) {",
									"    var jsonData = JSON.parse(responseBody);",
									"    pm.environment.set('token', jsonData.token);",
									"    pm.environment.set('userId', jsonData.user.id);",
									"    console.log('Login successful, token saved');",
									"} else {",
									"    console.log('Login failed:', responseBody);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Get Profile",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/auth/me",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"me"
							]
						}
					}
				},
				{
					"name": "Debug - Create Test User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"{{userPassword}}\",\n  \"username\": \"debuguser\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/create-debug-user",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"create-debug-user"
							]
						}
					}
				}
			]
		},
		{
			"name": "Chat (Firebase Integration)",
			"item": [
				{
					"name": "Get User Chat Rooms",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/chat/rooms",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"chat",
								"rooms"
							]
						}
					}
				},
				{
					"name": "Create Chat Room",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Firebase Test Room\",\n  \"type\": \"community\",\n  \"description\": \"Testing Firebase integration\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/chat/rooms",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"chat",
								"rooms"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (responseCode.code === 201) {",
									"    var jsonData = JSON.parse(responseBody);",
									"    pm.environment.set('chatRoomId', jsonData.chatRoom._id);",
									"    console.log('Chat room created:', jsonData.chatRoom._id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Send Message (Firebase Sync)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"content\": \"Hello Firebase! This message will sync to real-time database.\",\n  \"messageType\": \"text\",\n  \"priority\": \"normal\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/chat/rooms/{{chatRoomId}}/messages",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"chat",
								"rooms",
								"{{chatRoomId}}",
								"messages"
							]
						}
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (responseCode.code === 201) {",
									"    var jsonData = JSON.parse(responseBody);",
									"    pm.environment.set('messageId', jsonData.message._id);",
									"    console.log('Message sent to Firebase:', jsonData.message._id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Update Push Token (Firebase)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{token}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"pushToken\": \"YOUR_FIREBASE_PUSH_TOKEN_HERE\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/chat/push-token",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"chat",
								"push-token"
							]
						}
					}
				}
			]
		},
		{
			"name": "Utilities",
			"item": [
				{
					"name": "Test Database Connection",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/auth/test-login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"test-login"
							]
						}
					}
				},
				{
					"name": "Bulk Create Users",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"count\": 3,\n  \"password\": \"{{userPassword}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/bulk-create-users",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"bulk-create-users"
							]
						}
					}
				}
			]
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Set default environment variables if not set",
					"if (!pm.environment.get('baseUrl')) {",
					"    pm.environment.set('baseUrl', 'http://localhost:3001/api');",
					"}",
					"if (!pm.environment.get('userEmail')) {",
					"    pm.environment.set('userEmail', 'test@example.com');",
					"}",
					"if (!pm.environment.get('userPassword')) {",
					"    pm.environment.set('userPassword', 'password123');",
					"}"
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:3001/api",
			"type": "string"
		},
		{
			"key": "userEmail",
			"value": "test@example.com",
			"type": "string"
		},
		{
			"key": "userPassword",
			"value": "password123",
			"type": "string"
		}
	]
}